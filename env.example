# =============================================================================
# AISim Ad Automation - Environment Configuration
# =============================================================================
# 
# SECURITY WARNING: Never commit this file with real values!
# Copy this file to .env and fill in your actual values.
# The .env file is gitignored and will not be committed.
#
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL database password - Use a strong password (20+ characters)
DB_PASSWORD=your_secure_password_here

# Alternative: Full database URL (overrides separate DB settings)
# DATABASE_URL=postgresql://user:password@host:5432/database

# Redis URL for caching and sessions
# REDIS_URL=redis://host:6379

# -----------------------------------------------------------------------------
# Stripe Payment Processing
# -----------------------------------------------------------------------------
# Get your keys from: https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_) for development, live keys (sk_live_) for production
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secret for verifying Stripe events
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# Google Cloud Services
# -----------------------------------------------------------------------------
# Get your API key from: https://console.cloud.google.com/apis/credentials
# 
# Required APIs to enable:
# - Generative Language API (Gemini) - for AI ad generation
# - Places API (New) - for lead generation
# - YouTube Data API v3 - for ad inspiration
#
# SECURITY: Set API restrictions in Google Cloud Console:
# - Application restrictions: HTTP referrers or IP addresses
# - API restrictions: Only enable required APIs
# - Set up quotas and usage limits
#
# IMPORTANT: Never commit real API keys to source control!
GOOGLE_API_KEY=your_google_api_key_here

# -----------------------------------------------------------------------------
# Brave Search API (Optional)
# -----------------------------------------------------------------------------
# For enhanced lead generation and competitive research
# Get your key from: https://brave.com/search/api
# Leave empty to disable Brave Search features
BRAVE_API_KEY=

# -----------------------------------------------------------------------------
# Anthropic Claude API (Alternative to Google AI)
# -----------------------------------------------------------------------------
# If you prefer to use Claude instead of Google Gemini for ad generation
# Get your key from: https://console.anthropic.com
# Leave empty if using Google AI
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Application Security
# -----------------------------------------------------------------------------
# JWT Secret for authentication tokens
# MUST be at least 32 characters long
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# Encryption key for sensitive data at rest
# MUST be at least 32 characters long
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your_encryption_key_here

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3001

# Backend API URL (for frontend API calls)
BACKEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Node environment: development, production, test
NODE_ENV=development

# Application port (default: 3000)
PORT=3000

# -----------------------------------------------------------------------------
# Production Settings (Uncomment for production deployment)
# -----------------------------------------------------------------------------
# NODE_ENV=production
# FRONTEND_URL=https://yourdomain.com
# BACKEND_URL=https://api.yourdomain.com

# -----------------------------------------------------------------------------
# Secrets Generation Commands
# -----------------------------------------------------------------------------
# Use one of these commands to generate secure secrets:
#
# OpenSSL:
#   openssl rand -base64 32
#
# Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Python:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# -----------------------------------------------------------------------------
# Security Reminders
# -----------------------------------------------------------------------------
# ✅ DO:
#   - Use strong, unique passwords
#   - Generate new secrets for each environment
#   - Use test/sandbox keys for development
#   - Set API restrictions in provider dashboards
#   - Rotate keys every 90 days
#   - Keep this file out of version control
#
# ❌ DON'T:
#   - Commit real API keys to Git
#   - Use the same keys for dev and production
#   - Share keys in public channels
#   - Use short or simple secrets
#   - Hardcode keys in source code
#   - Reuse keys across projects
#
# -----------------------------------------------------------------------------

